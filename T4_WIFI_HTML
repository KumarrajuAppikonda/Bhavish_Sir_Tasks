// =====================================================
// HOME PAGE
// =====================================================

void handleRoot()
{
    server.send(200, "text/html", getHTML());
}

// =====================================================
// SAVE WIFI BUTTON
// =====================================================

void handleSave()
{
    String newSSID = server.arg("ssid");

    String newPassword = server.arg("password");

    Serial.println();
    Serial.println("================================");
    Serial.println("New Wi-Fi Configuration Received");
    Serial.println("================================");

    Serial.print("SSID: ");
    Serial.println(newSSID);

    // =================================================
    // SAVE CREDENTIALS
    // =================================================

    saveWiFiCredentials(newSSID, newPassword);

    // =================================================
    // DISCONNECT OLD WIFI
    // =================================================

    WiFi.disconnect();

    delay(500);

    // =================================================
    // CONNECT TO NEW WIFI
    // =================================================

    bool connected = connectToWiFi(
        newSSID,
        newPassword
    );

    // =================================================
    // HTML RESULT PAGE
    // =================================================

    String html = "";

    html += "<!DOCTYPE html>";

    html += "<html>";

    html += "<head>";

    html += "<meta name='viewport' ";
    html += "content='width=device-width, initial-scale=1.0'>";

    html += "<title>Wi-Fi Status</title>";

    html += "<style>";

    html += "body{";
    html += "font-family:Arial;";
    html += "text-align:center;";
    html += "padding:30px;";
    html += "}";

    html += ".box{";
    html += "max-width:400px;";
    html += "margin:auto;";
    html += "padding:25px;";
    html += "border-radius:15px;";
    html += "background:#f2f2f2;";
    html += "}";

    html += "</style>";

    html += "</head>";

    html += "<body>";

    html += "<div class='box'>";

    // =================================================
    // SUCCESS
    // =================================================

    if (connected)
    {
        html += "<h2>Wi-Fi Connected!</h2>";

        html += "<p><b>Connected Network:</b></p>";

        html += "<p>";
        html += WiFi.SSID();
        html += "</p>";

        html += "<p><b>ESP32 IP Address:</b></p>";

        html += "<p>";
        html += WiFi.localIP().toString();
        html += "</p>";

        html += "<p><b>Signal Strength:</b></p>";

        html += "<p>";
        html += String(WiFi.RSSI());
        html += " dBm";
        html += "</p>";

        html += "<br>";

        html += "<a href='/'>Back to Configuration</a>";
    }

    // =================================================
    // FAILED
    // =================================================

    else
    {
        html += "<h2>Wi-Fi Connection Failed</h2>";

        html += "<p>";

        html += "Could not connect to:<br><br>";

        html += "<b>";
        html += newSSID;
        html += "</b>";

        html += "</p>";

        html += "<p>";
        html += "Please check the Wi-Fi name and password.";
        html += "</p>";

        html += "<br>";

        html += "<a href='/'>Try Again</a>";
    }

    html += "</div>";

    html += "</body>";

    html += "</html>";

    server.send(200, "text/html", html);
}

// =====================================================
// SETUP
// =====================================================

void setup()
{
    // =================================================
    // SERIAL
    // =================================================

    Serial.begin(115200);

    delay(1000);

    Serial.println();

    Serial.println("================================");

    Serial.println("      ESP32 WIFI CONFIG");

    Serial.println("================================");

    // =================================================
    // WS2812 INITIALIZATION
    // =================================================

    FastLED.addLeds<LED_TYPE, LED_PIN, COLOR_ORDER>(
        leds,
        NUM_LEDS
    );

    FastLED.setBrightness(LED_BRIGHTNESS);

    setLEDColor(CRGB::Black);

    // =================================================
    // LOAD SAVED WIFI
    // =================================================

    loadWiFiCredentials();

    // =================================================
    // START AP + STATION MODE
    // =================================================

    WiFi.mode(WIFI_AP_STA);

    // Start ESP32 Access Point

    WiFi.softAP(
        AP_SSID,
        AP_PASSWORD
    );

    // =================================================
    // AP INFORMATION
    // =================================================

    Serial.println();

    Serial.println("ESP32 Access Point Started");

    Serial.print("AP SSID: ");

    Serial.println(AP_SSID);

    Serial.print("AP Password: ");

    Serial.println(AP_PASSWORD);

    Serial.print("AP IP Address: ");

    Serial.println(WiFi.softAPIP());

    // =================================================
    // DEFAULT LED STATUS
    // =================================================

    // Violet = AP mode
    ledStatus = LED_AP_MODE;

    // =================================================
    // TRY SAVED WIFI
    // =================================================

    if (savedSSID.length() > 0)
    {
        Serial.println();

        Serial.println("Saved Wi-Fi found.");

        connectToWiFi(
            savedSSID,
            savedPassword
        );
    }

    // =================================================
    // WEB SERVER
    // =================================================

    server.on(
        "/",
        HTTP_GET,
        handleRoot
    );

    server.on(
        "/save",
        HTTP_POST,
        handleSave
    );

    server.begin();

    Serial.println();

    Serial.println("Web Server Started");

    Serial.println();

    Serial.println("Connect your phone to:");

    Serial.println(AP_SSID);

    Serial.println();

    Serial.println("Password:");

    Serial.println(AP_PASSWORD);

    Serial.println();

    Serial.println("Open browser:");

    Serial.println("http://192.168.4.1");

    Serial.println();

    Serial.println("================================");
}

// =====================================================
// LOOP
// =====================================================

void loop()
{
    // =================================================
    // HANDLE WEB REQUESTS
    // =================================================

    server.handleClient();

    // =================================================
    // CHECK AP PHONE CONNECTION
    // =================================================

    if (WiFi.status() != WL_CONNECTED)
    {
        int connectedDevices = WiFi.softAPgetStationNum();

        if (connectedDevices > 0)
        {
            // ==========================================
            // PHONE CONNECTED TO ESP32 AP
            // ==========================================

            if (ledStatus != LED_WIFI_FAILED)
            {
                ledStatus = LED_PHONE_CONNECTED;
            }
        }
        else
        {
            // ==========================================
            // AP RUNNING BUT NO PHONE
            // ==========================================

            if (ledStatus != LED_WIFI_FAILED)
            {
                ledStatus = LED_AP_MODE;
            }
        }
    }

    // =================================================
    // WIFI CONNECTED
    // =================================================

    if (WiFi.status() == WL_CONNECTED)
    {
        ledStatus = LED_WIFI_CONNECTED;
    }

    // =================================================
    // UPDATE WS2812 BLINK
    // =================================================

    updateLED();
}
