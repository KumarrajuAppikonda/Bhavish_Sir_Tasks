void setup()
{
    Serial.begin(115200);
    delay(300);

    Serial.println();
    Serial.println("================================");
    Serial.println("DEVICE INITIALIZATION STARTED");
    Serial.println("================================");

    pinMode(BUTTON_PIN, INPUT_PULLUP);
    Serial.print("BUTTON TEST: Button initial level = ");
    Serial.println(digitalRead(BUTTON_PIN) == LOW ? " ON " : " OFF ");
    Serial.println("BUTTON TEST: Press BOOT; live status should show Button  = ON ");

    Serial.println("INIT: Initializing WS2812 LEDs...");
    FastLED.addLeds<LED_TYPE, LED_PIN, COLOR_ORDER>(leds, NUM_LEDS);
    FastLED.setBrightness(LED_BRIGHTNESS); 
    setLEDStatus(LED_AP_MODE);          // violet at start
    Serial.println("INIT: WS2812 initialization complete.");

    setenv("TZ", TZ_INFO, 1);
    tzset();

    loadWiFiCredentials();

    // Web server routes.
    Serial.println("INIT: Registering web server routes...");
    server.on("/", HTTP_GET, handleRoot);
    server.on("/save", HTTP_POST, handleSave);
    server.on("/status", HTTP_GET, handleStatus);

    // Android / Apple / Windows captive-portal probes.
    server.on("/generate_204", HTTP_ANY, handleRedirect);
    server.on("/gen_204", HTTP_ANY, handleRedirect);
    server.on("/hotspot-detect.html", HTTP_ANY, handleRedirect);
    server.on("/library/test/success.html", HTTP_ANY, handleRedirect);
    server.on("/success.txt", HTTP_ANY, handleRedirect);
    server.on("/connecttest.txt", HTTP_ANY, handleRedirect);
    server.on("/ncsi.txt", HTTP_ANY, handleRedirect);
    server.on("/redirect", HTTP_ANY, handleRedirect);
    server.on("/canonical.html", HTTP_ANY, handleRedirect);
    server.on("/fwlink", HTTP_ANY, handleRedirect);
    server.onNotFound(handleRedirect);

    // Initialize Wi-Fi before starting the web server.
    // Wi-Fi sleep is left at its default; disabling it is not required here.
    Serial.println("INIT: Starting Wi-Fi driver in station mode...");
    WiFi.mode(WIFI_STA);
    delay(100);

    Serial.println("INIT: Starting web server...");
    server.begin();

    // Start the configuration AP immediately on every boot. The station
    // connection attempt runs alongside it in AP+STA mode.
    Serial.println("INIT: Starting configuration AP for the initial 60-second window...");
    startAP(true);

    if (savedSSID.length() > 0)
    {
        // Credentials were loaded from NVS flash above. Try this saved router
        // automatically at every boot while the configuration AP is available.
        Serial.print("BOOT: Auto-connecting to saved SSID: ");
        Serial.println(savedSSID);
        startWiFiConnection(savedSSID, savedPassword, false);
    }
    else
    {
        // No credentials have been saved yet. Keep the configuration AP open
        // so the user can enter Wi-Fi details; do not pretend to search for a
        // network when there is no saved SSID to try.
        emptySavedSearchActive = false;
        retryPhase = RP_IDLE;
        Serial.println("STATUS: No saved network; enter Wi-Fi details on the configuration page.");
    }
}

