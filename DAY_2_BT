void printDateTimePeriodically()
{
    const unsigned long nowMs = millis();
    if (nowMs - lastSerialTimePrint < SERIAL_TIME_INTERVAL_MS) return;
    lastSerialTimePrint = nowMs;

    // Build the complete status in one string and overwrite the same terminal row.
    String line;
    line.reserve(320);

    line += "[";
    line += (timeSynced ? getTimeString() : String("DATE/TIME NOT SYNCED"));
    line += "] | ";

    if (WiFi.status() == WL_CONNECTED)
    {
        line += "Router = ";
        line += WiFi.SSID();

    }
    else
    {
        line += "Router = DISCONNECTED";
    }

    line += " | AP = ";
    line += (apActive ? "ON" : "OFF");

    if (apActive && apWindowExpires != 0)
    {
        long remainingMs = (long)(apWindowExpires - nowMs);
        if (remainingMs > 0)
        {
            const unsigned long remainingSec = (remainingMs + 999) / 1000;
            line += " | AP left = ";
            line += String(remainingSec);
            line += "s";
        }
    }

    // Always include client count so the status fields stay in a consistent order.
    line += " | DEVICE = ";
    line += String(apActive ? WiFi.softAPgetStationNum() : 0);

    // Saved network search / retry countdown.
    line += " | SAVED Network: ";

    if (WiFi.status() == WL_CONNECTED && !userAttemptFailed)
    {
        line += WiFi.SSID();
        line += " | STATUS: CONNECTED";
    }
    else if (wifiAttemptInProgress && !userAttempt)
    {
        const unsigned long elapsed = nowMs - wifiAttemptStart;
        const unsigned long remainingMs = (elapsed >= SAVED_WIFI_CHECK_MS)
                                            ? 0
                                            : (SAVED_WIFI_CHECK_MS - elapsed);
        const unsigned long remainingSec = (remainingMs + 999) / 1000;

        line += (savedSSID.length() > 0 ? savedSSID : String("NOTHING"));
        line += " | SEARCH: ";
        line += String(remainingSec);
        line += " sec";
    }
    else if (retryPhase == RP_WAITING)
    {
        const unsigned long elapsed = nowMs - retryPhaseStart;
        const unsigned long remainingMs = (elapsed >= RETRY_WAIT_MS)
                                            ? 0
                                            : (RETRY_WAIT_MS - elapsed);
        const unsigned long remainingSec = (remainingMs + 999) / 1000;
        const unsigned long minutesLeft = remainingSec / 60;
        const unsigned long secondsLeft = remainingSec % 60;

        line += "NOT FOUND | SEARCH AFTER: ";
        line += String(minutesLeft);
        line += "m ";
        if (secondsLeft < 10) line += "0";
        line += String(secondsLeft);
        line += " sec";
    }
    else if (savedSSID.length() == 0)
    {
        // Initial state: no credentials have ever been saved, so there is no
        // saved network to search for. The user must configure one via the AP.
        line += "NOT FOUND | STATUS: NO SAVED CREDENTIALS";
    }
    else if (emptySavedSearchActive)
    {
        // Defensive fallback; this normally stays false when there is no SSID.
        line += "NOT FOUND | STATUS: NO SAVED CREDENTIALS";
    }
    else
    {
        line += "NOT FOUND | STATUS: WAITING FOR NEXT SEARCH";
    }

    // Button state and countdown are included on the same live row.
   // Button state and countdown are included on the same live row.
line += " | Button = ";
line += (digitalRead(BUTTON_PIN) == LOW ? "ON" : "OFF");

    if (btnDown && !btnHandled)
    {
        const unsigned long elapsed = nowMs - btnStart;
        const unsigned long remaining = (elapsed >= BUTTON_HOLD_MS)
                                          ? 0
                                          : (BUTTON_HOLD_MS - elapsed + 999) / 1000;
        line += " | Button counts =";
        line += String(remaining);
        line += "s";
    }
    else if (btnHandled)
    {
        line += " | Button = 10s COMPLETE";
    }

    // '\r' returns to the beginning of the same row; padding erases old leftovers.
    Serial.write('\r');
    Serial.print(line);
    if (previousStatusLineLength > line.length())
    {
        for (size_t i = line.length(); i < previousStatusLineLength; ++i)
        {
            Serial.write(' ');
        }
    }
    previousStatusLineLength = line.length();
}

