String jsonEscape(const String& in)
{
    String out = "";
    for (unsigned int i = 0; i < in.length(); i++)
    {
        char c = in[i];
        if (c == '"' || c == '\\') out += '\\';
        out += c;
    }
    return out;
}

void handleRoot()
{
    server.sendHeader("Cache-Control", "no-store");
    server.send_P(200, "text/html", CONFIG_PAGE);
}

void handleSave()
{
    String newSSID = server.arg("ssid");
    String newPassword = server.arg("password");

    newSSID.trim();

    if (newSSID.length() == 0)
    {
        server.send(400, "text/plain", "Wi-Fi name is required.");
        return;
    }

    Serial.println();
    Serial.println("STATUS: New network configuration received.");

    // Send the result page first, then start connecting
    // (STA channel change may drop the phone briefly).
    server.send_P(200, "text/html", RESULT_PAGE);
    delay(100);

    startWiFiConnection(newSSID, newPassword, true);
}

void handleStatus()
{
    String json = "{";

    if (WiFi.status() == WL_CONNECTED)
    {
        json += "\"state\":\"connected\",";
        json += "\"ssid\":\"" + jsonEscape(WiFi.SSID()) + "\",";
        json += "\"ip\":\"" + WiFi.localIP().toString() + "\",";
        json += "\"time\":\"" + getTimeString() + "\"";
    }
    else if (wifiAttemptInProgress && userAttempt)
    {
        json += "\"state\":\"connecting\"";
    }
    else if (userAttemptFailed)
    {
        json += "\"state\":\"failed\"";
    }
    else
    {
        json += "\"state\":\"idle\"";
    }

    json += "}";

    server.sendHeader("Cache-Control", "no-store");
    server.send(200, "application/json", json);
}

// Captive portal: every probe / unknown URL goes to the config page.
void handleRedirect()
{
    String target = "http://" +
        (apActive ? apIP.toString() : WiFi.localIP().toString()) + "/";

    server.sendHeader("Location", target, true);
    server.sendHeader("Cache-Control", "no-store");
    server.send(302, "text/plain", "");
}

