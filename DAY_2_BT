// =====================================================
// 6. LED STATUS
// =====================================================

enum LED_STATUS
{
    LED_NONE,
    LED_AP_MODE,
    LED_PHONE_CONNECTED,
    LED_WIFI_CONNECTED,
    LED_WIFI_FAILED
};

LED_STATUS ledStatus = LED_NONE;

void showLEDColor(CRGB color)
{
    for (int i = 0; i < NUM_LEDS; i++) leds[i] = color;
    FastLED.show();
}

void setLEDStatus(LED_STATUS s)
{
    if (ledStatus == s) return;
    ledStatus = s;

    switch (s)
    {
        case LED_AP_MODE:
            showLEDColor(CRGB(148, 0, 211));
            break;
        case LED_PHONE_CONNECTED:
            showLEDColor(CRGB(0, 0, 255));
            break;
        case LED_WIFI_CONNECTED:
            showLEDColor(CRGB(0, 255, 0));
            break;
        case LED_WIFI_FAILED:
            showLEDColor(CRGB(255, 0, 0));
            break;
        default:
            break;
    }
}

void updateLEDStatus()
{
    int clients = apActive ? WiFi.softAPgetStationNum() : 0;

    // Clear an old failure indication after the phone disconnects.
    if (clients == 0 && !restoringPreviousNetwork)
    {
        userAttemptFailed = false;
    }

    // Wrong candidate credentials: show RED while the phone is still connected.
    if (userAttemptFailed && clients > 0)
    {
        setLEDStatus(LED_WIFI_FAILED);
        return;
    }

    // Router connection takes priority once the previous/new network is online.
    if (WiFi.status() == WL_CONNECTED)
    {
        setLEDStatus(LED_WIFI_CONNECTED);
        return;
    }

    // Phone connected to configuration AP while router is offline.
    if (clients > 0)
    {
        setLEDStatus(LED_PHONE_CONNECTED);
        return;
    }

    // AP is available and waiting.
    setLEDStatus(LED_AP_MODE);
}

// =====================================================
// 7. SAVED CREDENTIALS
// =====================================================

void loadWiFiCredentials()
{
    // Preferences uses ESP32 NVS flash storage. Data survives normal power-off.
    if (!preferences.begin("wifi", true))
    {
        savedSSID = "";
        savedPassword = "";
        Serial.println("ERROR: Could not open Wi-Fi Preferences for reading.");
        return;
    }

    savedSSID     = preferences.getString("ssid", "");
    savedPassword = preferences.getString("password", "");
    preferences.end();

    // Clean up any placeholder value left by an older firmware version.
    if (savedSSID.equalsIgnoreCase("NOTHING") ||
        savedSSID.equalsIgnoreCase("NOT FOUND"))
    {
        savedSSID = "";
        savedPassword = "";
    }

    if (savedSSID.length() > 0)
    {
        Serial.print("STATUS: Saved Wi-Fi credentials loaded from flash. SSID = ");
        Serial.println(savedSSID);
        Serial.println("STATUS: ESP32 will automatically reconnect to this network.");
    }
    else
    {
        Serial.println("STATUS: No saved Wi-Fi credentials in flash.");
        Serial.println("ACTION: Configure Wi-Fi on http://192.168.4.1; credentials are saved after connection succeeds.");
    }
}

bool saveWiFiCredentials(const String& ssid, const String& password)
{
    if (ssid.length() == 0)
    {
        Serial.println("ERROR: Empty SSID; credentials were not saved.");
        return false;
    }

    // Write the credentials to non-volatile NVS flash, not temporary RAM.
    if (!preferences.begin("wifi", false))
    {
        Serial.println("ERROR: Could not open Wi-Fi Preferences for writing.");
        return false;
    }

    size_t ssidBytes = preferences.putString("ssid", ssid);
    size_t passwordBytes = preferences.putString("password", password);

    // Read back before closing to verify that the flash write succeeded.
    String verifySSID = preferences.getString("ssid", "");
    String verifyPassword = preferences.getString("password", "");
    preferences.end();

    if (ssidBytes == 0 || verifySSID != ssid || verifyPassword != password)
    {
        Serial.println("ERROR: Wi-Fi credentials could not be verified in flash.");
        return false;
    }

    savedSSID = verifySSID;
    savedPassword = verifyPassword;
    emptySavedSearchActive = false;
    retryPhase = RP_IDLE;

    Serial.println("STATUS: Wi-Fi credentials SAVED and VERIFIED in ESP32 flash (Preferences/NVS).");
    Serial.print("STATUS: Saved SSID = ");
    Serial.println(savedSSID);
    Serial.println("INFO: Credentials will remain after normal power-off/restart.");
    return true;
}

// =====================================================
// 8. ACCESS POINT START / STOP
// =====================================================

void startAP(bool restartWindow = true)
{
    if (!apActive)
    {
        Serial.println("INIT: Enabling AP + station mode...");
        WiFi.mode(WIFI_AP_STA);
        delay(100);

        if (!WiFi.softAPConfig(apIP, gateway, subnet))
        {
            Serial.println("ERROR: softAPConfig failed.");
        }

        delay(100);
        if (!WiFi.softAP(AP_SSID, AP_PASSWORD, 1, 0, 4))
        {
            Serial.println("ERROR: SoftAP start failed.");
            return;
        }

        dnsServer.start(53, "*", apIP);
        apActive = true;
        Serial.println("STATUS: Configuration AP ACTIVE.");
        Serial.print("Network name: ");
        Serial.println(AP_SSID);
        Serial.print("Configuration address: http://");
        Serial.println(WiFi.softAPIP());
    }

    if (restartWindow)
    {
        apWindowStarted = millis();
        apWindowExpires = apWindowStarted + AP_WINDOW_MS;
        Serial.println("STATUS: AP one-minute window started/restarted.");
    }
}

void stopAP()
{
    if (!apActive) return;

    dnsServer.stop();
    WiFi.softAPdisconnect(true);
    apActive = false;
    apWindowStarted = 0;
    apWindowExpires = 0;

    // Keep station mode enabled so saved-router retry can continue.
    WiFi.mode(WIFI_STA);
    Serial.println("STATUS: AP window ended; configuration AP CLOSED.");
}

// =====================================================
// 9. WIFI CONNECTION (START + RESULT)
// =====================================================

void startWiFiConnection(const String& ssid, const String& password, bool initiatedByUser)
{
    Serial.println();
    Serial.println("================================");
    Serial.println(initiatedByUser ? "STATUS: Trying NEW Wi-Fi credentials."
                                   : "STATUS: Checking SAVED Wi-Fi network.");
    Serial.print("Target network: ");
    Serial.println(ssid);
    Serial.println("================================");

    pendingSSID = ssid;
    pendingPassword = password;
    userAttempt = initiatedByUser;
    if (initiatedByUser) userAttemptFailed = false;
    wasConnected = false;
    lostSince = 0;

    // Preserve the configuration AP if it is running; otherwise use station
    // mode only. This avoids accidentally enabling AP+STA without an AP.
    WiFi.mode(apActive ? WIFI_AP_STA : WIFI_STA);
    WiFi.setAutoReconnect(false);
    WiFi.persistent(false); // Preferences/NVS below is the source of truth.

    // Switching to a candidate router can disconnect the old station link.
    // The previous credentials remain saved and are restored if this fails.
    WiFi.disconnect(false, false);
    delay(250);

    wifiAttemptStart = millis();
    wifiAttemptInProgress = true;
    retryPhase = RP_IDLE;
    WiFi.begin(pendingSSID.c_str(), pendingPassword.c_str());
}

void checkWiFiConnection()
{
    if (!wifiAttemptInProgress) return;

    // Only accept a connection to the network currently being tested.
    if (WiFi.status() == WL_CONNECTED && WiFi.SSID() == pendingSSID)
    {
        wifiAttemptInProgress = false;
        retryPhase = RP_IDLE;
        emptySavedSearchActive = false;
        wasConnected = true;
        lostSince = 0;

        Serial.println();
        Serial.println("STATUS: Router connection successful.");
        Serial.print("Connected network: ");
        Serial.println(WiFi.SSID());
        Serial.print("Device IP address: ");
        Serial.println(WiFi.localIP());
        Serial.print("Signal strength: ");
        Serial.print(WiFi.RSSI());
        Serial.println(" dBm");

        if (userAttempt)
        {
            // Save only after the candidate network has actually connected.
            // The function verifies the values by reading them back from flash.
            if (saveWiFiCredentials(pendingSSID, pendingPassword))
            {
                userAttemptFailed = false;
                restoringPreviousNetwork = false;
                retryPhase = RP_IDLE;
                emptySavedSearchActive = false;
                Serial.println("STATUS: New network saved; previous credentials replaced.");
            }
            else
            {
                Serial.println("ERROR: Wi-Fi is connected, but flash save failed. Do not power off until this is fixed.");
            }
        }
        else if (restoringPreviousNetwork)
        {
            // The candidate failed; the old network is back online.
            restoringPreviousNetwork = false;
            userAttemptFailed = false;
            Serial.println("STATUS: Saved network restored; LED returns to GREEN.");
        }
        else
        {
            Serial.println("STATUS: Saved network is available.");
        }

        userAttempt = false;
        needSync = true;
        lastSyncTry = 0;
        return;
    }

    unsigned long timeout = userAttempt ? USER_WIFI_TIMEOUT_MS : SAVED_WIFI_CHECK_MS;
    if (millis() - wifiAttemptStart < timeout) return;

    bool wasUserCandidate = userAttempt;
    wifiAttemptInProgress = false;
    WiFi.disconnect(false, false);

    Serial.println();
    if (wasUserCandidate)
    {
        userAttemptFailed = true;
        restoringPreviousNetwork = (savedSSID.length() > 0);
        Serial.println("STATUS: NEW Wi-Fi credentials FAILED (RED LED).");
        Serial.println("ACTION: Previous saved credentials are unchanged; restoring previous network.");

        // Restore the previous working network immediately, without saving the
        // rejected candidate. Keep userAttemptFailed true so the LED can show red
        // while the phone remains connected to the configuration AP.
        userAttempt = false;
        if (savedSSID.length() > 0)
        {
            startWiFiConnection(savedSSID, savedPassword, false);
        }
        else
        {
            retryPhase = RP_IDLE;
            Serial.println("INFO: No previous network was saved; AP remains active.");
        }
    }
    else
    {
        Serial.println("STATUS: Saved network check failed.");
        if (!apActive)
        {
            startAP(true);
        }

        if (savedSSID.length() > 0)
        {
            retryPhase = RP_WAITING;
            retryPhaseStart = millis();
            Serial.println("STATUS: Next saved-network retry scheduled in 4 min 30 sec.");
        }
        else
        {
            retryPhase = RP_IDLE;
        }
    }
}

// =====================================================
// 10. 5-MINUTE RETRY CYCLE + WIFI LOSS DETECTION
// =====================================================

void handleRetryCycle()
{
    if (retryPhase != RP_WAITING) return;

    // Cancel the retry timer only if the ESP32 is connected to the network
    // that is actually saved. A connection to some other SSID must not prevent
    // the saved network from being tested.
    if (wifiAttemptInProgress)
    {
        return;
    }

    if (WiFi.status() == WL_CONNECTED && WiFi.SSID() == savedSSID)
    {
        retryPhase = RP_IDLE;
        return;
    }

    if (millis() - retryPhaseStart < RETRY_WAIT_MS) return;

    // After the 4m30 wait, test the saved network for up to 30 seconds.
    if (savedSSID.length() == 0)
    {
        // No real SSID exists to connect to. Start another visible 30-second
        // search-status window, then the normal 4m30s waiting period.
        retryPhase = RP_IDLE;
        emptySavedSearchActive = true;
        emptySavedSearchStart = millis();
        return;
    }

    retryPhase = RP_CHECKING;
    startWiFiConnection(savedSSID, savedPassword, false);
}

void handleEmptySavedSearchCycle()
{
    if (savedSSID.length() > 0)
    {
        emptySavedSearchActive = false;
        return;
    }

    if (!emptySavedSearchActive) return;

    if (millis() - emptySavedSearchStart >= SAVED_WIFI_CHECK_MS)
    {
        emptySavedSearchActive = false;
        retryPhase = RP_WAITING;
        retryPhaseStart = millis();
    }
}

void handleWiFiLoss()
{
    if (WiFi.status() == WL_CONNECTED)
    {
        wasConnected = true;
        lostSince = 0;
        return;
    }

    if (!wasConnected || wifiAttemptInProgress) return;

    if (lostSince == 0)
    {
        lostSince = millis();
    }
    else if (millis() - lostSince >= WIFI_LOST_MS)
    {
        Serial.println("STATUS: Router Wi-Fi lost; configuration AP remains active.");
        wasConnected = false;
        lostSince = 0;

        if (savedSSID.length() > 0)
        {
            retryPhase = RP_WAITING;
            retryPhaseStart = millis() - RETRY_WAIT_MS; // retry immediately once
        }
    }
}

// =====================================================
// 11. BUTTON: HOLD 10 s -> AP MODE
// =====================================================

void forceAPMode()
{
    // Keep button countdown/status output on the same live status row.
    userAttemptFailed = false;
    startAP(true); // start AP if closed, or restart its one-minute window
}

void handleButton()
{
    // Most ESP32 DevKit BOOT buttons are active LOW on GPIO0.
    const bool pressed = (digitalRead(BUTTON_PIN) == LOW);
    const unsigned long now = millis();

    if (pressed)
    {
        if (!btnDown)
        {
            btnDown = true;
            btnHandled = false;
            btnStart = now;
        }
        else if (!btnHandled && (now - btnStart >= BUTTON_HOLD_MS))
        {
            btnHandled = true;
            forceAPMode();
        }
    }
    else
    {
        btnDown = false;
        btnHandled = false;
    }
}

void handleAPHousekeeping()
{
    if (!apActive || apWindowExpires == 0) return;
    if ((long)(millis() - apWindowExpires) < 0) return;

    // The AP window is strictly 60 seconds, even if a phone is connected.
    // A new 10-second button hold opens a fresh 60-second window.
    stopAP();
}

// =====================================================
// 13. TIME SYNC WITHOUT NTP (HTTP Date header)
// =====================================================

bool fetchHttpDate(const char* host)
{
    WiFiClient client;
    client.setTimeout(4);

    if (!client.connect(host, 80, 4000)) return false;

    client.print(String("HEAD / HTTP/1.1\r\nHost: ") + host +
                 "\r\nUser-Agent: ESP32\r\nConnection: close\r\n\r\n");

    unsigned long start = millis();
    String dateLine = "";

    while ((client.connected() || client.available()) && millis() - start < 5000)
    {
        if (!client.available())
        {
            delay(5);
            continue;
        }

        String line = client.readStringUntil('\n');
        line.trim();

        if (line.length() == 0) break;      // end of headers

        String low = line;
        low.toLowerCase();
        if (low.startsWith("date:"))
        {
            dateLine = line;
            break;
        }
    }

    client.stop();

    if (dateLine.length() == 0) return false;

    // Example: "Date: Wed, 28 Oct 2026 12:16:00 GMT"
    int d, y, h, m, s;
    char mon[4] = {0};

    if (sscanf(dateLine.c_str(), "%*[^,], %d %3s %d %d:%d:%d",
               &d, mon, &y, &h, &m, &s) != 6) return false;

    const char* months = "JanFebMarAprMayJunJulAugSepOctNovDec";
    const char* p = strstr(months, mon);
    if (!p) return false;
    int monIdx = (p - months) / 3;

    if (y < 2024) return false;

    struct tm t = {};
    t.tm_year = y - 1900;
    t.tm_mon  = monIdx;
    t.tm_mday = d;
    t.tm_hour = h;
    t.tm_min  = m;
    t.tm_sec  = s;
    t.tm_isdst = 0;

    // Convert UTC broken-down time to epoch.
    setenv("TZ", "UTC0", 1);
    tzset();
    time_t epoch = mktime(&t);

    // Back to local time zone.
    setenv("TZ", TZ_INFO, 1);
    tzset();

    struct timeval tv;
    tv.tv_sec = epoch;
    tv.tv_usec = 0;
    settimeofday(&tv, NULL);

    return true;
}

String getTimeString()
{
    if (!timeSynced) return "Not synced";

    time_t now = time(nullptr);
    struct tm ti;
    localtime_r(&now, &ti);

    char buf[32];
    strftime(buf, sizeof(buf), "%d-%b-%Y %H:%M:%S", &ti);
    return String(buf);
}

void syncTimeHTTP()
{
    const char* hosts[] = { "www.google.com", "www.cloudflare.com", "www.microsoft.com" };

    lastSyncTry = millis();

    for (int i = 0; i < 3; i++)
    {
        if (fetchHttpDate(hosts[i]))
        {
            timeSynced = true;
            lastSyncOk = millis();
            needSync = false;

            Serial.print("STATUS: Time synced via HTTP (");
            Serial.print(hosts[i]);
            Serial.print("): ");
            Serial.println(getTimeString());
            return;
        }
    }

    // HTTP Date-header sync did not work. Try standard NTP as a fallback.
    // This also handles routers that provide Wi-Fi but restore internet later.
    Serial.println("STATUS: HTTP time sync failed; trying NTP fallback...");
    configTime(0, 0, "pool.ntp.org", "time.google.com", "time.cloudflare.com");

    const unsigned long ntpStart = millis();
    while (millis() - ntpStart < 8000UL)
    {
        time_t now = time(nullptr);
        if (now > 1735689600) // 2025-01-01; reject an unset system clock
        {
            timeSynced = true;
            lastSyncOk = millis();
            needSync = false;
            Serial.print("STATUS: Time synced via NTP: ");
            Serial.println(getTimeString());
            return;
        }
        delay(200);
        yield();
    }

    // Keep needSync true. handleTimeSync() will try again after TIME_RETRY_MS.
    timeSynced = false;
    needSync = true;
    Serial.println("STATUS: Internet/time sync not ready; will retry automatically.");
}

void handleTimeSync()
{
    if (WiFi.status() != WL_CONNECTED) return;

    bool due = !timeSynced || needSync || (millis() - lastSyncOk >= TIME_RESYNC_MS);
    if (!due) return;

    if (lastSyncTry != 0 && millis() - lastSyncTry < TIME_RETRY_MS) return;

    syncTimeHTTP();
}

